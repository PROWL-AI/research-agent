{
  "$id": "https://prowl.chat/fabric/schemas/research.run.input.json",
  "type": "object",
  "properties": {
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "context": {
      "type": "object",
      "properties": {
        "requester": {
          "type": "string",
          "maxLength": 256
        },
        "chain": {
          "type": "string",
          "maxLength": 256
        },
        "project": {
          "type": "string",
          "maxLength": 256
        },
        "node": {
          "type": "string",
          "maxLength": 256
        },
        "parent": {
          "type": "string",
          "maxLength": 256
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "runbook": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "inputs": {
      "type": "object"
    },
    "max_llm_usd": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000,
      "description": "Cap on this run's own LLM spend (USD), checked before every LLM call; unset: the service's RESEARCH_MAX_LLM_USD, the runbook's, else 5."
    },
    "resumeJobId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Continue the run of an ended research job of the same runbook: saved evidence is reused, nothing already paid is dispatched again."
    }
  },
  "required": [
    "idempotencyKey",
    "runbook",
    "inputs"
  ],
  "additionalProperties": false
}
